<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Moyu</AssemblyName>
    <RootNamespace>Moyu</RootNamespace>
    <ApplicationIcon>..\icons\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Version>3.3.2</Version>
    <FileVersion>3.3.2.0</FileVersion>
    <AssemblyVersion>3.3.2.0</AssemblyVersion>
    <Company>Moyu</Company>
    <Product>摸鱼笔记本</Product>
    <Description>摸鱼笔记本：把网址、账号和随手想到的事，丢进一个只存在本机的本子里。</Description>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <UseRidGraph>true</UseRidGraph>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\icons\app.ico">
      <Link>Assets\app.ico</Link>
    </Resource>
    <Resource Include="..\icons\icon-192.png">
      <Link>Assets\app.png</Link>
    </Resource>
    <Resource Include="..\icons\icon-512.png">
      <Link>Assets\app-large.png</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\styles.css" Link="web\styles.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\app.js" Link="web\app.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\manifest.webmanifest" Link="web\manifest.webmanifest" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\sw.js" Link="web\sw.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\使用说明.txt" Link="使用说明.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\icons\**\*" Link="web\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
