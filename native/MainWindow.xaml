<Window x:Class="Moyu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="摸鱼笔记本"
        Width="1280" Height="840"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F2EFE6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei">

    <Window.Resources>
        <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#2C2B27" />
        <SolidColorBrush x:Key="ChromeMutedBrush" Color="#8B887C" />
        <SolidColorBrush x:Key="ChromeHoverBrush" Color="#ECE8DC" />
        <SolidColorBrush x:Key="ChromeLineBrush" Color="#16000000" />

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeHover" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontSize="10"
                                              TextElement.FontFamily="Segoe MDL2 Assets"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeHover" Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeHover" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeHover" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontSize="10"
                                              TextElement.FontFamily="Segoe MDL2 Assets"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeHover" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeHover" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Windows chrome -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="#F2EFE6"
                BorderBrush="{DynamicResource ChromeLineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="13,0,0,0"
                            VerticalAlignment="Center">
                    <Image x:Name="TitleIcon"
                           Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/Assets/app.png" />
                    <TextBlock x:Name="TitleText"
                               Text="摸鱼笔记本"
                               Margin="8,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ChromeForegroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="MinButton"
                            Style="{StaticResource ChromeButton}"
                            Content="&#xE921;"
                            ToolTip="最小化"
                            Click="MinButton_Click" />
                    <Button x:Name="MaxButton"
                            Style="{StaticResource ChromeButton}"
                            Content="&#xE922;"
                            ToolTip="最大化"
                            Click="MaxButton_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ChromeCloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="关闭到托盘"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Web content -->
        <Grid Grid.Row="1" x:Name="WebHost">
            <wv2:WebView2 x:Name="Web" />
            <Border x:Name="LoadingOverlay" Background="#F2EFE6">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="50" Height="50"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/Assets/app-large.png" />
                    <TextBlock Text="摸鱼笔记本"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#2C2B27" />
                    <TextBlock x:Name="LoadingText"
                               Text="正在打开…"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="#7F7C70" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
