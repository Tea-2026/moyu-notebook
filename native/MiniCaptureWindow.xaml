<Window x:Class="Moyu.MiniCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记一条"
        Width="36" Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        AllowDrop="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#2C2B27" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6E6B61" />
        <SolidColorBrush x:Key="FaintBrush" Color="#8A867A" />
        <SolidColorBrush x:Key="LineBrush" Color="#E1DBCE" />
        <SolidColorBrush x:Key="PaperBrush" Color="#F2EFE6" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FBFAF5" />
        <SolidColorBrush x:Key="DropBrush" Color="#ECE8DC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#45645D" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#38534D" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E2EAE4" />

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#C9D8CF" />
            <Setter Property="AllowDrop" Value="False" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ECE8DC" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#F8F5EC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="Margin" Value="1,0,0,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            Margin="8"
            Background="{StaticResource PaperBrush}"
            BorderBrush="#DAD4C6"
            BorderThickness="1"
            CornerRadius="12"
            RenderTransformOrigin="1,1">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>

        <Grid>
            <!-- Collapsed fish tail -->
            <Grid x:Name="CollapsedPanel"
                  Width="20" Height="72"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  Opacity="0.94"
                  ToolTip="拖进来，或点一下新建；按住鱼尾可以拖到屏幕边缘"
                  MouseLeftButtonDown="CollapsedPanel_MouseLeftButtonDown">
                <Grid.LayoutTransform>
                    <RotateTransform x:Name="CollapsedRotate" Angle="0" />
                </Grid.LayoutTransform>
                <Border x:Name="CollapsedBorder" Background="{StaticResource AccentBrush}" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox x:Name="FishIcon" Width="15" Height="12" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="FishRotate" Angle="0" />
                            </Viewbox.RenderTransform>
                            <Path Width="24" Height="24"
                                  Stretch="Uniform"
                                  Fill="#F2EFE6"
                                  Data="M3.5 12c2.8-4.2 7-6.2 11.3-5.3 3.3.7 5.5 2.6 6.7 5.3-1.2 2.7-3.4 4.6-6.7 5.3C10.5 18.2 6.3 16.2 3.5 12Z M6 12 2 8v8l4-4Z" />
                        </Viewbox>
                        <Rectangle x:Name="CollapsedLine"
                                   Width="1" Height="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   RadiusX="0.5" RadiusY="0.5"
                                   Fill="#F2EFE6"
                                   Opacity="0.35" />
                        <Ellipse x:Name="CollapsedDot"
                                 Width="3" Height="3"
                                 HorizontalAlignment="Center"
                                 Margin="0,5,0,0"
                                 Fill="#E4D394"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Expanded quick capture -->
            <Grid x:Name="ExpandedPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F6F3EA"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="11,11,0,0"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="ExpandedHeader_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="20" Height="15"
                                  Stretch="Uniform"
                                  Fill="{StaticResource AccentBrush}"
                                  Data="M3.5 12c2.8-4.2 7-6.2 11.3-5.3 3.3.7 5.5 2.6 6.7 5.3-1.2 2.7-3.4 4.6-6.7 5.3C10.5 18.2 6.3 16.2 3.5 12Z M6 12 2 8v8l4-4Z" />
                            <TextBlock Text="记一条"
                                       Margin="8,0,0,0"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="TypePill"
                                    Margin="10,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="9"
                                    Background="{StaticResource AccentSoftBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TypeText"
                                           FontSize="9.5"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource FlatButton}"
                                Width="26" Height="26"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="✕"
                                FontSize="14"
                                ToolTip="收起"
                                Click="CloseButton_Click" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ContentScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalContentAlignment="Center"
                              Padding="0,0,2,0">
                    <StackPanel x:Name="ContentStack" Margin="18,16,18,8" VerticalAlignment="Center">
                        <Border x:Name="DropHint"
                                Padding="18,24"
                                CornerRadius="8"
                                Background="#ECE8DC"
                                BorderBrush="#D9D3C5"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonUp="DropHint_MouseLeftButtonUp">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="34" Height="25"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="1.3"
                                      Fill="Transparent"
                                      Data="M3.5 12c2.8-4.2 7-6.2 11.3-5.3 3.3.7 5.5 2.6 6.7 5.3-1.2 2.7-3.4 4.6-6.7 5.3C10.5 18.2 6.3 16.2 3.5 12Z M6 12 2 8v8l4-4Z" />
                                <TextBlock Text="新建笔记"
                                           Margin="0,12,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="拖进来，或点一下开始写"
                                           Margin="0,4,0,0"
                                           FontSize="10.5"
                                           Foreground="{StaticResource FaintBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="NewKindPanel" Margin="0,10,0,0">
                            <TextBlock Text="或者新建"
                                       Margin="2,0,0,5"
                                       FontSize="9"
                                       Foreground="{StaticResource FaintBrush}" />
                            <UniformGrid Columns="3">
                                <Button Content="备忘" Tag="memo" Style="{StaticResource FlatButton}"
                                        Height="28" Margin="2" FontSize="10.5" Click="NewKind_Click" />
                                <Button Content="网址" Tag="site" Style="{StaticResource FlatButton}"
                                        Height="28" Margin="2" FontSize="10.5" Click="NewKind_Click" />
                                <Button Content="密码" Tag="password" Style="{StaticResource FlatButton}"
                                        Height="28" Margin="2" FontSize="10.5" Click="NewKind_Click" />
                                <Button Content="日记" Tag="diary" Style="{StaticResource FlatButton}"
                                        Height="28" Margin="2" FontSize="10.5" Click="NewKind_Click" />
                                <Button Content="笔记" Tag="notes" Style="{StaticResource FlatButton}"
                                        Height="28" Margin="2" FontSize="10.5" Click="NewKind_Click" />
                                <Button Content="日程" Tag="schedule" Style="{StaticResource FlatButton}"
                                        Height="28" Margin="2" FontSize="10.5" Click="NewKind_Click" />
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel x:Name="FormPanel" Visibility="Collapsed">
                            <TextBlock x:Name="SourceText"
                                       FontSize="10"
                                       Foreground="{StaticResource FaintBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="1,0,0,12" />

                            <TextBlock Text="标题" Style="{StaticResource TinyLabel}" />
                            <TextBox x:Name="TitleBox"
                                     Style="{StaticResource FieldBox}"
                                     MaxLength="300"
                                     Margin="0,0,0,12" />

                            <Border x:Name="PreviewFrame"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,12"
                                    CornerRadius="6"
                                    Background="#ECE8DC"
                                    ClipToBounds="True">
                                <Image x:Name="PreviewImage"
                                       MaxHeight="150"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <Border x:Name="AttachmentFrame"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,12"
                                    Padding="10,8"
                                    CornerRadius="6"
                                    Background="#ECE8DC">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource MutedBrush}"
                                          StrokeThickness="1.4"
                                          Fill="Transparent"
                                          Data="M4.5 9.5h3l4.2-3.8v12.6l-4.2-3.8h-3z M15.4 8.6a4.8 4.8 0 0 1 0 6.8" />
                                    <TextBlock x:Name="AttachmentText"
                                               Margin="8,0,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="备注" Style="{StaticResource TinyLabel}" />
                            <TextBox x:Name="BodyBox"
                                     Style="{StaticResource FieldBox}"
                                     Height="76"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="标签" Style="{StaticResource TinyLabel}" />
                            <TextBox x:Name="TagsBox"
                                     Style="{StaticResource FieldBox}"
                                     Margin="0,0,0,4" />
                            <TextBlock Text="用逗号分隔，可以不填"
                                       FontSize="9"
                                       Foreground="{StaticResource FaintBrush}"
                                       Margin="1,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        Background="#F6F3EA"
                        CornerRadius="0,0,11,11">
                    <Grid Margin="16,0,12,0">
                        <TextBlock x:Name="StatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="CancelButton"
                                    Style="{StaticResource FlatButton}"
                                    Content="取消"
                                    Margin="0,0,4,0"
                                    Click="CancelButton_Click" />
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="收好"
                                    Click="SaveButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
